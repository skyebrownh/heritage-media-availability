# Copy this file to .env and fill in real values. Never commit .env.
# Run commands with: uv run --env-file .env python manage.py <command>

# Long random string. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# "true" locally for helpful error pages; always "false" in production.
DEBUG=true

# Comma-separated hostnames the site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Homebrew Postgres uses your macOS username with no password.
DATABASE_URL=postgresql://your-username@localhost:5432/heritage_media_availability
